From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: open-cam-fw <open-cam-fw@example.invalid>
Date: Thu, 12 Nov 2026 01:00:05 -0800
Subject: [PATCH] build for Linux 6.18 on the FH8626V200 camera

- build: use ccflags-y for include paths (EXTRA_CFLAGS is gone)
- fmac: adapt to the cfg80211 API of Linux 6.18
- core: adapt to kernel API changes up to Linux 6.18
---
 Makefile               |  2 +-
 config.mak             |  2 --
 fmac/cfg_ops.c         | 31 ++++++++++++++++++-------------
 fmac/fmac_mod_params.c |  6 ++++--
 fmac/fmac_msg_tx.c     | 24 ++++++++++++------------
 fmac/fmac_utils.c      |  2 +-
 fmac/fmac_utils.h      |  2 +-
 fmac/netdev_ops.c      |  6 +++---
 ssvdevice/init.c       |  4 ++--
 utils/debugfs.c        |  4 ++--
 10 files changed, 44 insertions(+), 39 deletions(-)

diff --git a/Makefile b/Makefile
index 67869ee..d02faf7 100755
--- a/Makefile
+++ b/Makefile
@@ -9,7 +9,7 @@ SSV_DRV_PATH ?= $(PWD)
 
 include $(KBUILD_TOP)/config.mak
 
-EXTRA_CFLAGS := -I$(KBUILD_TOP) -I$(KBUILD_TOP)/include
+ccflags-y += -I$(KBUILD_TOP) -I$(KBUILD_TOP)/include
 
 #------------------------------
 # ssvdevice/
diff --git a/config.mak b/config.mak
index 80e33ce..a2d78fa 100755
--- a/config.mak
+++ b/config.mak
@@ -1,6 +1,4 @@
 KVERSION="$(uname -r)"
-EXTRA_CFLAGS := -I$(KBUILD_TOP) 
-EXTRA_CFLAGS += -I$(KBUILD_TOP)/include 
 
 CONFIG_SSV6X5X=m
 
