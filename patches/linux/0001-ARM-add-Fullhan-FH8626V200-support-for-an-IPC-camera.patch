+/* Split a total gain (32 = 1x) into coarse analogue, coarse and fine digital */
+static int sc2336_set_gain(struct sc2336 *sc2336, u32 gain)
+{
+	u32 again, dgain = 0, fine;
+	u32 factor = gain * 1000 / 32;	/* gain in 1/1000 */
+	int ret = 0;
+
+	if (factor < 1000) {
+		again = 0x00;
+		fine = 0x80;
+	} else if (factor < 2 * 1000) {
+		again = 0x00;
+		fine = factor * 128 / 1000;
+	} else if (factor < 4 * 1000) {
+		again = 0x08;
+		fine = factor * 128 / 1000 / 2;
+	} else if (factor < 8 * 1000) {
+		again = 0x09;
+		fine = factor * 128 / 1000 / 4;
+	} else if (factor < 16 * 1000) {
+		again = 0x0b;
+		fine = factor * 128 / 1000 / 8;
+	} else if (factor < 32 * 1000) {
+		again = 0x0f;
+		fine = factor * 128 / 1000 / 16;
+	} else if (factor < 64 * 1000) {
+		/* maximum analogue gain, digital gain from here */
+		again = 0x1f;
+		fine = factor * 128 / 1000 / 32;
+	} else if (factor < 128 * 1000) {
+		again = 0x1f;
+		dgain = 0x01;
+		fine = factor * 128 / 1000 / 64;
+	} else {
+		again = 0x1f;
+		dgain = 0x03;
+		fine = 0x80;
+	}
+	fine &= ~3;
+
+	cci_write(sc2336->regmap, SC2336_REG_DIG_GAIN, dgain, &ret);
+	cci_write(sc2336->regmap, SC2336_REG_DIG_FINE_GAIN, fine, &ret);
+	cci_write(sc2336->regmap, SC2336_REG_ANA_GAIN, again, &ret);
+
+	return ret;
+}
+
+static int sc2336_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct sc2336 *sc2336 = container_of(ctrl->handler, struct sc2336,
+					     ctrl_handler);
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		/* Update max exposure while meeting expected vblanking */
+		s64 max = SC2336_NATIVE_HEIGHT + ctrl->val -
+			  SC2336_EXPOSURE_MARGIN;
+
+		ret = __v4l2_ctrl_modify_range(sc2336->exposure,
+					       sc2336->exposure->minimum, max,
+					       sc2336->exposure->step,
+					       sc2336->exposure->default_value);
+		if (ret)
+			return ret;
+	}
+
+	/* Applied when streaming starts if the sensor is powered off now */
+	if (!pm_runtime_get_if_in_use(sc2336->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(sc2336->regmap, SC2336_REG_EXPOSURE,
+			  (u32)ctrl->val << 4, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = sc2336_set_gain(sc2336, ctrl->val);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(sc2336->regmap, SC2336_REG_VTS,
+			  SC2336_NATIVE_HEIGHT + ctrl->val, &ret);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		cci_update_bits(sc2336->regmap, SC2336_REG_TEST_PATTERN,
+				SC2336_TEST_PATTERN_ENABLE,
+				ctrl->val ? SC2336_TEST_PATTERN_ENABLE : 0,
+				&ret);
+		break;
+	case V4L2_CID_HFLIP:
+		cci_update_bits(sc2336->regmap, SC2336_REG_FLIP_MIRROR,
+				SC2336_MIRROR, ctrl->val ? SC2336_MIRROR : 0,
+				&ret);
+		break;
+	case V4L2_CID_VFLIP:
+		cci_update_bits(sc2336->regmap, SC2336_REG_FLIP_MIRROR,
+				SC2336_FLIP, ctrl->val ? SC2336_FLIP : 0, &ret);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put_autosuspend(sc2336->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops sc2336_ctrl_ops = {
+	.s_ctrl = sc2336_set_ctrl,
+};
+
+static int sc2336_init_controls(struct sc2336 *sc2336)
+{
+	struct v4l2_ctrl_handler *hdl = &sc2336->ctrl_handler;
+	const struct v4l2_ctrl_ops *ops = &sc2336_ctrl_ops;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	u32 hblank, vblank;
+	int ret;
+
+	ret = v4l2_fwnode_device_parse(sc2336->dev, &props);
+	if (ret)
+		return ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	ctrl = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ,
+				      ARRAY_SIZE(sc2336_link_freq_menu) - 1, 0,
+				      sc2336_link_freq_menu);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE, SC2336_PIXEL_RATE,
+			  SC2336_PIXEL_RATE, 1, SC2336_PIXEL_RATE);
+
+	hblank = SC2336_HTS - SC2336_NATIVE_WIDTH;
+	ctrl = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK, hblank, hblank, 1,
+				 hblank);
+	if (ctrl)
+		ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = SC2336_VTS_DEFAULT - SC2336_NATIVE_HEIGHT;
+	sc2336->vblank = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VBLANK, vblank,
+					   SC2336_VTS_MAX - SC2336_NATIVE_HEIGHT,
+					   1, vblank);
+
+	sc2336->exposure = v4l2_ctrl_new_std(hdl, ops, V4L2_CID_EXPOSURE,
+					     SC2336_EXPOSURE_MIN,
+					     SC2336_VTS_DEFAULT -
+					     SC2336_EXPOSURE_MARGIN,
+					     1, SC2336_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_ANALOGUE_GAIN, SC2336_GAIN_MIN,
+			  SC2336_GAIN_MAX, 1, SC2336_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, ops, V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(sc2336_test_pattern_menu) - 1,
+				     0, 0, sc2336_test_pattern_menu);
+
+	/* Bayer order with flip/mirror not verified: format kept as is */
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_HFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_new_std(hdl, ops, V4L2_CID_VFLIP, 0, 1, 1, 0);
+
+	v4l2_ctrl_new_fwnode_properties(hdl, ops, &props);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	sc2336->sd.ctrl_handler = hdl;
+
+	return 0;
+}
+
+static int sc2336_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct sc2336 *sc2336 = to_sc2336(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(sc2336->dev);
+	if (ret)
+		return ret;
+
+	ret = cci_multi_reg_write(sc2336->regmap, sc2336_1080p_30fps_regs,
+				  ARRAY_SIZE(sc2336_1080p_30fps_regs), NULL);
+	if (ret) {
+		dev_err(sc2336->dev, "failed to write mode registers\n");
+		goto error;
+	}
+
+	/* Apply controls set while the sensor was powered off */
+	ret = __v4l2_ctrl_handler_setup(&sc2336->ctrl_handler);
+	if (ret)
+		goto error;
+
+	ret = cci_write(sc2336->regmap, SC2336_REG_MODE_SELECT,
+			SC2336_MODE_STREAMING, NULL);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	pm_runtime_put_autosuspend(sc2336->dev);
+
+	return ret;
+}
+
+static int sc2336_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct sc2336 *sc2336 = to_sc2336(sd);
+	int ret;
+
+	ret = cci_write(sc2336->regmap, SC2336_REG_MODE_SELECT,
+			SC2336_MODE_STANDBY, NULL);
+
+	pm_runtime_put_autosuspend(sc2336->dev);
+
+	return ret;
+}
+
+static void sc2336_fill_format(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = SC2336_MBUS_CODE;
+	fmt->width = SC2336_NATIVE_WIDTH;
+	fmt->height = SC2336_NATIVE_HEIGHT;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+/* Only one mode: any requested format is replaced by the native one */
+static int sc2336_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	sc2336_fill_format(&fmt->format);
+	*v4l2_subdev_state_get_format(state, fmt->pad) = fmt->format;
+
+	return 0;
+}
+
+static int sc2336_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = SC2336_MBUS_CODE;
+
+	return 0;
+}
+
+static int sc2336_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	if (fse->index > 0 || fse->code != SC2336_MBUS_CODE)
+		return -EINVAL;
+
+	fse->min_width = SC2336_NATIVE_WIDTH;
+	fse->max_width = SC2336_NATIVE_WIDTH;
+	fse->min_height = SC2336_NATIVE_HEIGHT;
+	fse->max_height = SC2336_NATIVE_HEIGHT;
+
+	return 0;
+}
+
+static int sc2336_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	sc2336_fill_format(v4l2_subdev_state_get_format(state, 0));
+
+	return 0;
+}
