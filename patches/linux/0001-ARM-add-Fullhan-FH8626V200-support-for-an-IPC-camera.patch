+# SPDX-License-Identifier: GPL-2.0-only
+
+comment "Fullhan media platform drivers"
+
+config VIDEO_FH8626_ISP_BRINGUP
+	tristate "Fullhan FH8626V200 ISP bring-up helper"
+	depends on ARCH_FH8626 || COMPILE_TEST
+	depends on OF && HAS_IOMEM
+	help
+	  Interrupt service for bringing up the FH8626V200 ISP from user
+	  space: acknowledges the ISP interrupt, switches the statistics
+	  buffer and re-arms the raw dump in every frame, and exposes
+	  counters through sysfs. Not a capture driver.
+
+	  If unsure, say N.
+
+config VIDEO_FH8626_CAMERA
+	tristate "Fullhan FH8626V200 camera (CSI-2 receiver, ISP, VPU)"
+	depends on ARCH_FH8626 || COMPILE_TEST
+	depends on OF && HAS_IOMEM && VIDEO_DEV
+	select MEDIA_CONTROLLER
+	select VIDEO_V4L2_SUBDEV_API
+	select V4L2_FWNODE
+	select VIDEOBUF2_DMA_CONTIG
+	select MFD_SYSCON
+	help
+	  Video capture driver for the FH8626V200 camera path: MIPI CSI-2
+	  receiver, ISP and VPU channel 0, delivering 1920x1088 NV12 from
+	  a raw Bayer sensor such as the SC2336.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called fh8626-camera.
