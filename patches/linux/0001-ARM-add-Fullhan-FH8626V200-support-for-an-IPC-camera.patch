+static inline void isp_wr(struct fh_cam *cam, u32 off, u32 val)
+{
+	writel(val, cam->isp + off);
+}
+
+static inline u32 isp_rd(struct fh_cam *cam, u32 off)
+{
+	return readl(cam->isp + off);
+}
+
+static void fh_cam_wr_list(struct fh_cam *cam, const struct fh_cam_reg *regs,
+			   unsigned int n)
+{
+	while (n--) {
+		isp_wr(cam, regs->off, regs->val);
+		regs++;
+	}
+}
+
+static inline u32 pack16(u32 lo, u32 hi)
+{
+	return (hi << 16) | lo;
+}
