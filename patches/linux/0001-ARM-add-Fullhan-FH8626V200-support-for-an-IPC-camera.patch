diff --git a/drivers/misc/gpio-ircut.c b/drivers/misc/gpio-ircut.c
new file mode 100644
index 0000000..8627ecc
--- /dev/null
+++ b/drivers/misc/gpio-ircut.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Latching IR-cut filter driven through two GPIOs (an H-bridge input
+ * each): a short pulse on day-gpios moves the filter in front of the lens,
+ * a pulse on night-gpios moves it away. Both lines are low otherwise.
+ *
+ *   /sys/devices/platform/<node>/mode   rw  "day" or "night"
+ *
+ * The driver switches to day mode at probe so the state is known.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/sysfs.h>
+
+struct ircut {
+	struct gpio_desc *day, *night;
+	struct mutex lock;
+	u32 pulse_ms;
+	bool is_night;
+};
+
+static void ircut_set(struct ircut *ic, bool night)
+{
+	struct gpio_desc *g = night ? ic->night : ic->day;
+
+	gpiod_set_value_cansleep(g, 1);
+	msleep(ic->pulse_ms);
+	gpiod_set_value_cansleep(g, 0);
+	ic->is_night = night;
+}
+
+static ssize_t mode_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct ircut *ic = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s\n", READ_ONCE(ic->is_night) ? "night" : "day");
+}
+
+static ssize_t mode_store(struct device *dev, struct device_attribute *a,
+			  const char *buf, size_t len)
+{
+	struct ircut *ic = dev_get_drvdata(dev);
+	bool night;
+
+	if (sysfs_streq(buf, "night"))
+		night = true;
+	else if (sysfs_streq(buf, "day"))
+		night = false;
+	else
+		return -EINVAL;
+	/* always pulse: the filter may have been moved by hand or at power-up */
+	mutex_lock(&ic->lock);
+	ircut_set(ic, night);
+	mutex_unlock(&ic->lock);
+	return len;
+}
+static DEVICE_ATTR_RW(mode);
+
+static struct attribute *ircut_attrs[] = {
+	&dev_attr_mode.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(ircut);
+
+static int ircut_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ircut *ic;
+
+	ic = devm_kzalloc(dev, sizeof(*ic), GFP_KERNEL);
+	if (!ic)
+		return -ENOMEM;
+	mutex_init(&ic->lock);
+
+	ic->day = devm_gpiod_get(dev, "day", GPIOD_OUT_LOW);
+	if (IS_ERR(ic->day))
+		return dev_err_probe(dev, PTR_ERR(ic->day), "day-gpios\n");
+	ic->night = devm_gpiod_get(dev, "night", GPIOD_OUT_LOW);
+	if (IS_ERR(ic->night))
+		return dev_err_probe(dev, PTR_ERR(ic->night), "night-gpios\n");
+
+	ic->pulse_ms = 150;
+	device_property_read_u32(dev, "pulse-ms", &ic->pulse_ms);
+	ic->pulse_ms = clamp_t(u32, ic->pulse_ms, 10, 1000);
+
+	platform_set_drvdata(pdev, ic);
+	ircut_set(ic, false);
+	return 0;
+}
+
+static const struct of_device_id ircut_of_match[] = {
+	{ .compatible = "gpio-ircut" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ircut_of_match);
+
+static struct platform_driver ircut_driver = {
+	.probe = ircut_probe,
+	.driver = {
+		.name = "gpio-ircut",
+		.of_match_table = ircut_of_match,
+		.dev_groups = ircut_groups,
+	},
+};
+module_platform_driver(ircut_driver);
+
+MODULE_DESCRIPTION("Latching IR-cut filter on two GPIOs");
+MODULE_LICENSE("GPL");
diff --git a/drivers/misc/gpio-stepper.c b/drivers/misc/gpio-stepper.c
new file mode 100644
index 0000000..66b1689
--- /dev/null
+++ b/drivers/misc/gpio-stepper.c
@@ -0,0 +1,452 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Unipolar stepper motor on four GPIOs (coil 1..4), half- or full-stepped
+ * from an hrtimer, with a linear speed ramp at start, stop and reversal.
+ *
+ * Each motor appears as /sys/class/stepper/<label>/:
+ *
+ *   target     rw  write N to move to N, +N/-N to move relative; clamped to
+ *                  0..max_steps. The move runs in the background.
+ *   position   rw  current position; writable only while idle (to restore
+ *                  a saved position without moving)
+ *   moving     ro  1 while the motor runs; poll()able, notified at the end
+ *   stop       wo  decelerate and stop as soon as possible
+ *   home       wo  run max_steps towards 0 against the end stop, then 0
+ *   speed      rw  top speed in half-steps per second
+ *   max_steps  rw  travel range in half-steps
+ *   mode       rw  "half" (8 phases) or "full" (two coils, 4 phases)
+ *
+ * Positions and speeds are always in half-steps; in full-step mode a timer
+ * tick moves two of them. The coils are switched off when the motor is idle.
+ */
+
+#include <linux/gpio/consumer.h>
+#include <linux/hrtimer.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mod_devicetable.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/spinlock.h>
+#include <linux/sysfs.h>
+
+#define STEPPER_COILS		4
+#define STEPPER_START_SPEED	200	/* half-steps/s, ramp start and end */
+#define STEPPER_RAMP		32	/* ramp length in ticks */
+#define STEPPER_MAX_SPEED	4000
+#define STEPPER_SETTLE_NS	(20 * NSEC_PER_MSEC)	/* hold after the last step */
+
+/* Half-step sequence, bit n = coil n + 1; odd phases have two coils on. */
+static const u8 stepper_phases[8] = { 0x1, 0x3, 0x2, 0x6, 0x4, 0xc, 0x8, 0x9 };
+
+struct stepper {
+	struct device *dev;
+	struct gpio_descs *coils;
+	struct hrtimer timer;
+	struct kernfs_node *moving_kn;
+	spinlock_t lock;
+
+	/* all below under lock */
+	int pos;
+	int target;
+	int dir;		/* direction of the running move, 0 = none */
+	int ramp;		/* speed level 0..STEPPER_RAMP */
+	bool running;
+	bool settling;
+	bool full;
+	bool invert;
+	u32 speed;
+	u32 max_steps;
+};
+
+static void stepper_out(struct stepper *st, unsigned long bits)
+{
+	gpiod_set_array_value(st->coils->ndescs, st->coils->desc,
+			      st->coils->info, &bits);
+}
+
+static unsigned int stepper_phase(struct stepper *st)
+{
+	unsigned int p = ((st->pos % 8) + 8) % 8;
+
+	return st->invert ? 7 - p : p;
+}
+
+static u64 stepper_period(struct stepper *st, int halfsteps)
+{
+	u32 v0 = min_t(u32, STEPPER_START_SPEED, st->speed);
+	u32 v = v0 + (st->speed - v0) * st->ramp / STEPPER_RAMP;
+
+	return div_u64((u64)halfsteps * NSEC_PER_SEC, v);
+}
+
+static enum hrtimer_restart stepper_tick(struct hrtimer *t)
+{
+	struct stepper *st = container_of(t, struct stepper, timer);
+	unsigned long flags;
+	int dist, want, rem, n;
+	u64 ns;
+
+	spin_lock_irqsave(&st->lock, flags);
+
+	if (st->settling) {
+		stepper_out(st, 0);
+		st->settling = false;
+		st->running = false;
+		spin_unlock_irqrestore(&st->lock, flags);
+		sysfs_notify_dirent(st->moving_kn);
+		return HRTIMER_NORESTART;
+	}
+
+	dist = st->target - st->pos;
+	want = dist > 0 ? 1 : dist < 0 ? -1 : 0;
+	if (!st->dir)
+		st->dir = want;
+
+	if (want == st->dir && want) {
+		/* accelerate, but keep the stopping distance <= what is left */
+		rem = abs(dist);
+		st->ramp = min3(st->ramp + 1, STEPPER_RAMP, rem - 1);
+	} else if (st->ramp > 0) {
+		/* stop or reversal requested: brake in the old direction */
+		rem = INT_MAX;
+		st->ramp--;
+	} else {
+		/* standing still at speed level 0: turn around or finish */
+		st->dir = want;
+		if (!want) {
+			st->settling = true;
+			ns = STEPPER_SETTLE_NS;
+		} else {
+			ns = stepper_period(st, 1);
+		}
+		goto restart;
+	}
+
+	/* full-step: move between the two-coil phases (odd half-steps) */
+	n = 1;
+	if (st->full && (stepper_phase(st) & 1) && rem >= 2)
+		n = 2;
+	st->pos += n * st->dir;
+	stepper_out(st, stepper_phases[stepper_phase(st)]);
+	ns = stepper_period(st, n);
+
+restart:
+	spin_unlock_irqrestore(&st->lock, flags);
+	hrtimer_forward_now(t, ns_to_ktime(ns));
+	return HRTIMER_RESTART;
+}
+
+/* Called with the lock held. */
+static void stepper_go(struct stepper *st, int target)
+{
+	st->target = target;
+	st->settling = false;
+	if (!st->running) {
+		st->running = true;
+		st->dir = 0;
+		st->ramp = 0;
+		hrtimer_start(&st->timer, 0, HRTIMER_MODE_REL);
+	}
+}
+
+static int stepper_parse(const char *buf, int *val, bool *rel)
+{
+	*rel = buf[0] == '+' || buf[0] == '-';
+	return kstrtoint(buf, 0, val);
+}
+
+static ssize_t target_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", READ_ONCE(st->target));
+}
+
+static ssize_t target_store(struct device *dev, struct device_attribute *a,
+			    const char *buf, size_t len)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+	unsigned long flags;
+	bool rel;
+	int v, ret;
+
+	ret = stepper_parse(buf, &v, &rel);
+	if (ret)
+		return ret;
+	spin_lock_irqsave(&st->lock, flags);
+	if (rel)
+		v += st->target;
+	stepper_go(st, clamp_t(int, v, 0, st->max_steps));
+	spin_unlock_irqrestore(&st->lock, flags);
+	return len;
+}
+static DEVICE_ATTR_RW(target);
+
+static ssize_t position_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", READ_ONCE(st->pos));
+}
+
+static ssize_t position_store(struct device *dev, struct device_attribute *a,
+			      const char *buf, size_t len)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+	unsigned long flags;
+	int v, ret;
+
+	ret = kstrtoint(buf, 0, &v);
+	if (ret)
+		return ret;
+	if (v < 0 || v > st->max_steps)
+		return -ERANGE;
+	spin_lock_irqsave(&st->lock, flags);
+	if (st->running) {
+		ret = -EBUSY;
+	} else {
+		st->pos = v;
+		st->target = v;
+	}
+	spin_unlock_irqrestore(&st->lock, flags);
+	return ret ?: len;
+}
+static DEVICE_ATTR_RW(position);
+
+static ssize_t moving_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%d\n", READ_ONCE(st->running));
+}
+static DEVICE_ATTR_RO(moving);
+
+static ssize_t stop_store(struct device *dev, struct device_attribute *a,
+			  const char *buf, size_t len)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+	unsigned long flags;
+
+	spin_lock_irqsave(&st->lock, flags);
+	/* the target the ramp can reach without overshooting */
+	if (st->running)
+		st->target = clamp_t(int, st->pos + st->dir * st->ramp * (st->full ? 2 : 1),
+				     0, st->max_steps);
+	spin_unlock_irqrestore(&st->lock, flags);
+	return len;
+}
+static DEVICE_ATTR_WO(stop);
+
+static ssize_t home_store(struct device *dev, struct device_attribute *a,
+			  const char *buf, size_t len)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+	unsigned long flags;
+
+	spin_lock_irqsave(&st->lock, flags);
+	if (st->running) {
+		spin_unlock_irqrestore(&st->lock, flags);
+		return -EBUSY;
+	}
+	st->pos = st->max_steps;
+	stepper_go(st, 0);
+	spin_unlock_irqrestore(&st->lock, flags);
+	return len;
+}
+static DEVICE_ATTR_WO(home);
+
+static ssize_t speed_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", READ_ONCE(st->speed));
+}
+
+static ssize_t speed_store(struct device *dev, struct device_attribute *a,
+			   const char *buf, size_t len)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+	unsigned long flags;
+	u32 v;
+	int ret;
+
+	ret = kstrtou32(buf, 0, &v);
+	if (ret)
+		return ret;
+	if (!v || v > STEPPER_MAX_SPEED)
+		return -ERANGE;
+	spin_lock_irqsave(&st->lock, flags);
+	st->speed = v;
+	spin_unlock_irqrestore(&st->lock, flags);
+	return len;
+}
+static DEVICE_ATTR_RW(speed);
+
+static ssize_t max_steps_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", READ_ONCE(st->max_steps));
+}
+
+static ssize_t max_steps_store(struct device *dev, struct device_attribute *a,
+			       const char *buf, size_t len)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+	unsigned long flags;
+	u32 v;
+	int ret;
+
+	ret = kstrtou32(buf, 0, &v);
+	if (ret)
+		return ret;
+	if (!v || v > INT_MAX / 2)
+		return -ERANGE;
+	spin_lock_irqsave(&st->lock, flags);
+	st->max_steps = v;
+	spin_unlock_irqrestore(&st->lock, flags);
+	return len;
+}
+static DEVICE_ATTR_RW(max_steps);
+
+static ssize_t mode_show(struct device *dev, struct device_attribute *a, char *buf)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s\n", READ_ONCE(st->full) ? "full" : "half");
+}
+
+static ssize_t mode_store(struct device *dev, struct device_attribute *a,
+			  const char *buf, size_t len)
+{
+	struct stepper *st = dev_get_drvdata(dev);
+	unsigned long flags;
+	bool full;
+
+	if (sysfs_streq(buf, "full"))
+		full = true;
+	else if (sysfs_streq(buf, "half"))
+		full = false;
+	else
+		return -EINVAL;
+	spin_lock_irqsave(&st->lock, flags);
+	st->full = full;
+	spin_unlock_irqrestore(&st->lock, flags);
+	return len;
+}
+static DEVICE_ATTR_RW(mode);
+
+static struct attribute *stepper_attrs[] = {
+	&dev_attr_target.attr,
+	&dev_attr_position.attr,
+	&dev_attr_moving.attr,
+	&dev_attr_stop.attr,
+	&dev_attr_home.attr,
+	&dev_attr_speed.attr,
+	&dev_attr_max_steps.attr,
+	&dev_attr_mode.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(stepper);
+
+static const struct class stepper_class = {
+	.name = "stepper",
+	.dev_groups = stepper_groups,
+};
+
+static void stepper_cleanup(void *data)
+{
+	struct stepper *st = data;
+
+	hrtimer_cancel(&st->timer);
+	stepper_out(st, 0);
+	sysfs_put(st->moving_kn);
+	device_unregister(st->dev);
+}
+
+static int stepper_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct stepper *st;
+	const char *label;
+	int ret;
+
+	st = devm_kzalloc(dev, sizeof(*st), GFP_KERNEL);
+	if (!st)
+		return -ENOMEM;
+	spin_lock_init(&st->lock);
+	hrtimer_setup(&st->timer, stepper_tick, CLOCK_MONOTONIC, HRTIMER_MODE_REL);
+
+	st->coils = devm_gpiod_get_array(dev, "coil", GPIOD_OUT_LOW);
+	if (IS_ERR(st->coils))
+		return dev_err_probe(dev, PTR_ERR(st->coils), "coil-gpios\n");
+	if (st->coils->ndescs != STEPPER_COILS)
+		return dev_err_probe(dev, -EINVAL, "need %d coil-gpios\n", STEPPER_COILS);
+	for (int i = 0; i < STEPPER_COILS; i++)
+		if (gpiod_cansleep(st->coils->desc[i]))
+			return dev_err_probe(dev, -EINVAL, "coil GPIOs must not sleep\n");
+
+	st->speed = 500;
+	st->max_steps = 4096;
+	device_property_read_u32(dev, "steps-per-second", &st->speed);
+	device_property_read_u32(dev, "max-steps", &st->max_steps);
+	st->speed = clamp_t(u32, st->speed, 1, STEPPER_MAX_SPEED);
+	st->max_steps = clamp_t(u32, st->max_steps, 1, INT_MAX / 2);
+	st->invert = device_property_read_bool(dev, "invert-direction");
+	st->full = device_property_read_bool(dev, "full-step");
+	if (device_property_read_string(dev, "label", &label))
+		label = dev_name(dev);
+
+	st->dev = device_create(&stepper_class, dev, 0, st, "%s", label);
+	if (IS_ERR(st->dev))
+		return PTR_ERR(st->dev);
+	st->moving_kn = sysfs_get_dirent(st->dev->kobj.sd, "moving");
+	if (!st->moving_kn) {
+		device_unregister(st->dev);
+		return -ENODEV;
+	}
+	ret = devm_add_action_or_reset(dev, stepper_cleanup, st);
+	if (ret)
+		return ret;
+
+	dev_info(dev, "%s: %u half-steps, %u/s\n", label, st->max_steps, st->speed);
+	return 0;
+}
+
+static const struct of_device_id stepper_of_match[] = {
+	{ .compatible = "gpio-stepper" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, stepper_of_match);
+
+static struct platform_driver stepper_driver = {
+	.probe = stepper_probe,
+	.driver = {
+		.name = "gpio-stepper",
+		.of_match_table = stepper_of_match,
+	},
+};
+
+static int __init stepper_init(void)
+{
+	int ret = class_register(&stepper_class);
+
+	if (ret)
+		return ret;
+	ret = platform_driver_register(&stepper_driver);
+	if (ret)
+		class_unregister(&stepper_class);
+	return ret;
+}
+module_init(stepper_init);
+
+static void __exit stepper_exit(void)
+{
+	platform_driver_unregister(&stepper_driver);
+	class_unregister(&stepper_class);
+}
+module_exit(stepper_exit);
+
+MODULE_DESCRIPTION("Unipolar stepper motor on GPIOs");
+MODULE_LICENSE("GPL");
diff --git a/drivers/phy/Kconfig b/drivers/phy/Kconfig
