diff --git a/drivers/media/i2c/sc2336.c b/drivers/media/i2c/sc2336.c
new file mode 100644
index 0000000..37ab8a9
--- /dev/null
+++ b/drivers/media/i2c/sc2336.c
@@ -0,0 +1,780 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC2336 image sensor driver
+ *
+ * One mode: 1920x1080 RAW10 at 30 fps over 2 MIPI CSI-2 lanes (405 Mbit/s
+ * per lane), from a 24 MHz MCLK.
+ *
+ * The mode register table and the exposure, gain, flip and test pattern
+ * register handling come from the Rockchip sc2336 driver (GPL-2.0,
+ * Copyright (C) 2022 Rockchip Electronics Co., Ltd.). Chip ID, I2C address
+ * (0x30), MCLK and power-up order were verified on a Fullhan FH8626V200
+ * camera board.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+#include <media/v4l2-subdev.h>
+
+#define SC2336_MCLK_FREQ_24MHZ		(24 * HZ_PER_MHZ)
+#define SC2336_LINK_FREQ		202500000
+#define SC2336_LANES			2
+#define SC2336_BITS_PER_SAMPLE		10
+/* 81 MHz */
+#define SC2336_PIXEL_RATE		(SC2336_LINK_FREQ * 2 * SC2336_LANES / \
+					 SC2336_BITS_PER_SAMPLE)
+
+#define SC2336_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define SC2336_MODE_STANDBY		0x00
+#define SC2336_MODE_STREAMING		BIT(0)
+
+#define SC2336_REG_CHIP_ID		CCI_REG16(0x3107)
+#define SC2336_CHIP_ID			0xcb3a
+
+#define SC2336_REG_VTS			CCI_REG16(0x320e)
+#define SC2336_HTS			2250
+#define SC2336_VTS_DEFAULT		1200
+#define SC2336_VTS_MAX			0x7fff
+
+#define SC2336_REG_FLIP_MIRROR		CCI_REG8(0x3221)
+#define SC2336_MIRROR			(BIT(1) | BIT(2))
+#define SC2336_FLIP			(BIT(5) | BIT(6))
+
+/* Exposure in lines, register holds lines << 4 (4 fractional bits) */
+#define SC2336_REG_EXPOSURE		CCI_REG24(0x3e00)
+#define SC2336_EXPOSURE_MIN		1
+#define SC2336_EXPOSURE_MARGIN		6
+#define SC2336_EXPOSURE_DEFAULT		0x80
+
+#define SC2336_REG_DIG_GAIN		CCI_REG8(0x3e06)
+#define SC2336_REG_DIG_FINE_GAIN	CCI_REG8(0x3e07)
+#define SC2336_REG_ANA_GAIN		CCI_REG8(0x3e09)
+/* Total (analogue + digital) gain, 32 = 1x */
+#define SC2336_GAIN_MIN			0x20
+#define SC2336_GAIN_MAX			4096
+#define SC2336_GAIN_DEFAULT		0x80
+
+#define SC2336_REG_TEST_PATTERN		CCI_REG8(0x4501)
+#define SC2336_TEST_PATTERN_ENABLE	BIT(3)
+
+#define SC2336_NATIVE_WIDTH		1920
+#define SC2336_NATIVE_HEIGHT		1080
