diff --git a/arch/arm/boot/dts/fullhan/fh8626v200.dts b/arch/arm/boot/dts/fullhan/fh8626v200.dts
new file mode 100644
index 0000000..146499e
--- /dev/null
+++ b/arch/arm/boot/dts/fullhan/fh8626v200.dts
@@ -0,0 +1,395 @@
+/*
+ * Fullhan FH8626V200 -- minimal bring-up device tree (GPL-2.0).
+ *
+ * Fill in the two values below from the U-Boot CPU probe
+ * (CBAR and CNTFRQ) before building.
+ */
+/dts-v1/;
+#define FH8626_PERIPHBASE 0x30000000
+#define FH8626_CNTFRQ 24000000
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/clock/fullhan,fh8626-pmu.h>
+
+#ifndef FH8626_PERIPHBASE
+#error "Set FH8626_PERIPHBASE to the CBAR value read in U-Boot (see probe output)"
+#endif
+#ifndef FH8626_CNTFRQ
+#error "Set FH8626_CNTFRQ to the CNTFRQ value read in U-Boot (Hz)"
+#endif
+
+/ {
+	model = "Fullhan FH8626V200";
+	compatible = "fh,fh8626v200";
+	#address-cells = <1>;
+	#size-cells = <1>;
+	interrupt-parent = <&gic>;
+
+	aliases {
+		serial0 = &uart0;
+		i2c0 = &i2c0;
+	};
+
+	osc: clock-osc {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24000000>;
+		clock-output-names = "osc_clk";
+	};
+
+	chosen {
+		/* earlycon: UART0 is at 0xf0700000 (reg-shift 2, 32-bit access) */
+		bootargs = "earlycon=uart8250,mmio32,0xf0700000 console=ttyS0,115200 loglevel=8";
+		stdout-path = "serial0:115200n8";
+	};
+
+	memory@a0000000 {
+		device_type = "memory";
+		reg = <0xa0000000 0x04000000>;	/* 64 MiB */
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * Camera buffers (fh8626-camera): four 1920x1088 NV12 frames,
+		 * one 4 MiB block each (the pool allocates powers of two).
+		 * Without a kernel mapping, so cam-probe can still use the
+		 * area through /dev/mem when the camera driver is idle.
+		 */
+		camera_mem: camera@a3000000 {
+			compatible = "shared-dma-pool";
+			reg = <0xa3000000 0x1000000>;
+			no-map;
+		};
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a7";
+			reg = <0>;
+		};
+	};
+
+	timer {
+		compatible = "arm,armv7-timer";
+		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_LOW)>,
+			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(1) | IRQ_TYPE_LEVEL_LOW)>;
+		clock-frequency = <FH8626_CNTFRQ>;
+	};
+
+	/* Cortex-A7 integrated GIC-400: offsets are fixed relative to PERIPHBASE */
+	gic: interrupt-controller@0 {
+		compatible = "arm,cortex-a7-gic";
+		#interrupt-cells = <3>;
+		interrupt-controller;
+		reg = <(FH8626_PERIPHBASE + 0x1000) 0x1000>,
+		      <(FH8626_PERIPHBASE + 0x2000) 0x2000>,
+		      <(FH8626_PERIPHBASE + 0x4000) 0x2000>,
+		      <(FH8626_PERIPHBASE + 0x6000) 0x2000>;
+	};
+
+	reg_usb_vbus: regulator-usb-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		gpio = <&porta1 15 GPIO_ACTIVE_HIGH>;	/* GPIO47 */
+		enable-active-high;
+	};
+
+	/* Pan: GPIO0..3 (stock "motorH"), 8100 half-steps at 900/s */
+	stepper-pan {
+		compatible = "gpio-stepper";
+		label = "pan";
+		pinctrl-names = "default";
+		pinctrl-0 = <&pan_pins>;
+		coil-gpios = <&porta0 0 GPIO_ACTIVE_HIGH>, <&porta0 1 GPIO_ACTIVE_HIGH>,
+			     <&porta0 2 GPIO_ACTIVE_HIGH>, <&porta0 3 GPIO_ACTIVE_HIGH>;
+		max-steps = <8100>;
+		steps-per-second = <900>;
+	};
+
+	/* Tilt: GPIO37, 38, 41, 42 (stock "motorV"), 1140 half-steps at 600/s */
+	stepper-tilt {
+		compatible = "gpio-stepper";
+		label = "tilt";
+		pinctrl-names = "default";
+		pinctrl-0 = <&tilt_pins>;
+		coil-gpios = <&porta1 5 GPIO_ACTIVE_HIGH>, <&porta1 6 GPIO_ACTIVE_HIGH>,
+			     <&porta1 9 GPIO_ACTIVE_HIGH>, <&porta1 10 GPIO_ACTIVE_HIGH>;
+		max-steps = <1140>;
+		steps-per-second = <600>;
+	};
+
+	/*
+	 * Latching IR-cut: a pulse on GPIO4 (stock "ircut_neg") puts the
+	 * filter in (day), one on GPIO43 ("ircut_pos") takes it out (night).
+	 * Checked on the board with the camera image.
+	 */
+	ircut {
+		compatible = "gpio-ircut";
+		pinctrl-names = "default";
+		pinctrl-0 = <&ircut_pins>;
+		day-gpios = <&porta0 4 GPIO_ACTIVE_HIGH>;
+		night-gpios = <&porta1 11 GPIO_ACTIVE_HIGH>;
+		pulse-ms = <150>;
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&led_pins>;
+
+		led-white {
+			label = "white";
+			gpios = <&porta1 7 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+
+		led-ir {
+			label = "ir";
+			gpios = <&porta1 8 GPIO_ACTIVE_HIGH>;
+			default-state = "off";
+		};
+	};
+
+	keys {
+		compatible = "gpio-keys";
+		pinctrl-names = "default";
+		pinctrl-0 = <&key_pins>;
+
+		key-reset {
+			label = "reset";
+			gpios = <&porta1 12 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <20>;
+		};
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+
+		/* Also the clock provider, IDs in fullhan,fh8626-pmu.h */
+		pmu: syscon@f0000000 {
+			compatible = "fullhan,fh8626-pmu", "syscon";
+			reg = <0xf0000000 0x4000>;
+			clocks = <&osc>;
+			clock-names = "osc";
+			#clock-cells = <1>;
+		};
+
+		/*
+		 * Pad registers 0..47 at PMU + 0x80 + 4 * pad. Layout as written
+		 * by the stock fh_pinctrl: [27:24] function, 20 pull-up, 16
+		 * pull-down, [6:4] drive strength; bits 8, 12 and 28 are always
+		 * set (bit 12 not on MIPI pads). Entries are <offset value>.
+		 * After reset the sensor pads are in function 1 (GPIO).
+		 */
+		pinctrl: pinctrl@f0000080 {
+			compatible = "pinctrl-single";
+			reg = <0xf0000080 0xc0>;
+			#pinctrl-cells = <1>;
+			pinctrl-single,register-width = <32>;
+			pinctrl-single,function-mask = <0x1f111170>;
+
+			i2c0_pins: i2c0-pins {
+				pinctrl-single,pins = <
+					0x14 0x10101100	/* pad 5 I2C0_SCL, pull-up */
+					0x18 0x10101100	/* pad 6 I2C0_SDA, pull-up */
+				>;
+			};
+
+			sensor_pins: sensor-pins {
+				pinctrl-single,pins = <
+					0x1c 0x10001140	/* pad 7 SENSOR_CLK, drive 4 */
+					0x20 0x10001100	/* pad 8 GPIO13, sensor reset */
+				>;
+			};
+
+			/*
+			 * Actuator pads in function 1 (GPIO), no pulls. Pad map
+			 * from the stock fh_pinctrl table; the GPIO numbers are
+			 * those of the stock hardware.txt.
+			 */
+			pan_pins: pan-pins {
+				pinctrl-single,pins = <
+					0x50 0x01001000	/* pad 20 GPIO0 */
+					0x54 0x01001000	/* pad 21 GPIO1 */
+					0x58 0x01001000	/* pad 22 GPIO2 */
+					0x5c 0x01001000	/* pad 23 GPIO3 */
+				>;
+			};
+
+			tilt_pins: tilt-pins {
+				pinctrl-single,pins = <
+					0x34 0x01001000	/* pad 13 GPIO37 */
+					0x38 0x01001000	/* pad 14 GPIO38 */
+					0x3c 0x01001000	/* pad 15 GPIO41 */
+					0x40 0x01001000	/* pad 16 GPIO42 */
+				>;
+			};
+
+			ircut_pins: ircut-pins {
+				pinctrl-single,pins = <
+					0x48 0x01001000	/* pad 18 GPIO43, IR-cut + */
+					0x60 0x01001000	/* pad 24 GPIO4, IR-cut - */
+				>;
+			};
+
+			led_pins: led-pins {
+				pinctrl-single,pins = <
+					0x2c 0x01001000	/* pad 11 GPIO39, white LED */
+					0x30 0x01001000	/* pad 12 GPIO40, IR LED */
+				>;
+			};
+
+			key_pins: key-pins {
+				pinctrl-single,pins = <
+					0x4c 0x01001000	/* pad 19 GPIO44, reset key */
+				>;
+			};
+		};
+		gpio0: gpio@f0300000 {
+			compatible = "snps,dw-apb-gpio";
+			reg = <0xf0300000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			porta0: gpio-port@0 {
+				compatible = "snps,dw-apb-gpio-port";
+				reg = <0>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				ngpios = <32>;
+			};
+		};
+		gpio1: gpio@f4000000 {
+			compatible = "snps,dw-apb-gpio";
+			reg = <0xf4000000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			porta1: gpio-port@0 {
+				compatible = "snps,dw-apb-gpio-port";
+				reg = <0>;
+				gpio-controller;
+				#gpio-cells = <2>;
+				ngpios = <32>;
+			};
+
+		};
+		/*
+		 * Camera: ISP (with the VPU registers inside), MIPI wrap,
+		 * CSI-2 host, D-PHY and the JPEG encoder. Interrupts: media
+		 * irq offset 32 + 7 (ISP, confirmed on the board through the
+		 * GIC pending bits) and + 13 (JPEG, from jpeg.ko).
+		 */
+		camera@e8400000 {
+			compatible = "fullhan,fh8626v200-camera";
+			reg = <0xe8400000 0x100000>, <0xf1000000 0x1000>,
+			      <0xf1100000 0x1000>, <0xf1700000 0x1000>,
+			      <0xe8300000 0x1000>;
+			reg-names = "isp", "wrap", "csi", "dphy", "jpeg";
+			interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 13 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "isp", "jpeg";
+			fullhan,pmu = <&pmu>;
+			memory-region = <&camera_mem>;
+
+			port {
+				camera_in: endpoint {
+					remote-endpoint = <&sensor_out>;
+					data-lanes = <1 2>;
+				};
+			};
+		};
+
+		/*
+		 * Bring-up helper for cam-probe (interrupt service only, the
+		 * configuration is done from user space). Same registers as
+		 * the camera node: enable one of the two.
+		 */
+		isp@e8400000 {
+			compatible = "fullhan,fh8626-isp-bringup";
+			reg = <0xe8400000 0x100000>;
+			interrupts = <GIC_SPI 7 IRQ_TYPE_LEVEL_HIGH>;
+			status = "disabled";
+		};
+
+		/* Sensor bus: SC2336 at 0x30 */
+		i2c0: i2c@f0200000 {
+			compatible = "snps,designware-i2c";
+			reg = <0xf0200000 0x1000>;
+			interrupts = <GIC_SPI 11 IRQ_TYPE_LEVEL_HIGH>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2c0_pins>;
+			clocks = <&pmu FH8626_CLK_I2C0>;
+			clock-frequency = <100000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "okay";
+
+			sensor@30 {
+				compatible = "smartsens,sc2336";
+				reg = <0x30>;
+				pinctrl-names = "default";
+				pinctrl-0 = <&sensor_pins>;
+				/* MCLK: osc_clk / 1 */
+				clocks = <&pmu FH8626_CLK_CIS>;
+				assigned-clocks = <&pmu FH8626_CLK_CIS>;
+				assigned-clock-rates = <24000000>;
+				reset-gpios = <&porta0 13 GPIO_ACTIVE_LOW>;
+
+				port {
+					sensor_out: endpoint {
+						remote-endpoint = <&camera_in>;
+						data-lanes = <1 2>;
+						link-frequencies = /bits/ 64 <202500000>;
+					};
+				};
+			};
+		};
+
+		usb_phy: usb-phy {
+			compatible = "fullhan,fh8626-usb-phy";
+			fullhan,pmu = <&pmu>;
+			#phy-cells = <0>;
+			vbus-supply = <&reg_usb_vbus>;
+		};
+
+		usb@e0700000 {
+			compatible = "snps,dwc2";
+			reg = <0xe0700000 0x100000>;
+			interrupts = <0x00 0x27 0x04>;
+			phys = <&usb_phy>;
+			phy-names = "usb2-phy";
+			dr_mode = "host";
+		};
+		/*
+		 * No "interrupts" on purpose: the SoC interrupt routing into
+		 * the GIC is not verified yet, so the 8250 core falls back to
+		 * polling. earlycon does not need it.
+		 */
+		uart0: serial@f0700000 {
+			compatible = "snps,dw-apb-uart";
+			reg = <0xf0700000 0x100>;
+			reg-shift = <2>;
+			reg-io-width = <4>;
+			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
+			clock-frequency = <16666667>;
+			status = "okay";
+		};
+	};
+};
