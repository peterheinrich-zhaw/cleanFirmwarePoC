+static int sc2336_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sc2336 *sc2336 = to_sc2336(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(SC2336_NUM_SUPPLIES, sc2336->supplies);
+	if (ret)
+		return ret;
+
+	ret = clk_prepare_enable(sc2336->mclk);
+	if (ret)
+		goto disable_regulators;
+
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(sc2336->reset_gpio, 0);
+	/* 20 ms after reset worked on the board; no datasheet value yet */
+	usleep_range(20 * USEC_PER_MSEC, 25 * USEC_PER_MSEC);
+
+	return 0;
+
+disable_regulators:
+	regulator_bulk_disable(SC2336_NUM_SUPPLIES, sc2336->supplies);
+
+	return ret;
+}
+
+static int sc2336_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sc2336 *sc2336 = to_sc2336(sd);
+
+	gpiod_set_value_cansleep(sc2336->reset_gpio, 1);
+	clk_disable_unprepare(sc2336->mclk);
+	regulator_bulk_disable(SC2336_NUM_SUPPLIES, sc2336->supplies);
+
+	return 0;
+}
+
+static int sc2336_identify(struct sc2336 *sc2336)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(sc2336->regmap, SC2336_REG_CHIP_ID, &val, NULL);
+	if (ret)
+		return dev_err_probe(sc2336->dev, ret,
+				     "failed to read chip id\n");
+
+	if (val != SC2336_CHIP_ID)
+		return dev_err_probe(sc2336->dev, -ENODEV,
+				     "chip id mismatch: %#x != %#llx\n",
+				     SC2336_CHIP_ID, val);
+
+	dev_info(sc2336->dev, "SC2336 found, chip id %#llx\n", val);
+
+	return 0;
+}
+
+static int sc2336_probe(struct i2c_client *client)
+{
+	struct sc2336 *sc2336;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	sc2336 = devm_kzalloc(&client->dev, sizeof(*sc2336), GFP_KERNEL);
+	if (!sc2336)
+		return -ENOMEM;
+
+	sc2336->dev = &client->dev;
+
+	v4l2_i2c_subdev_init(&sc2336->sd, client, &sc2336_subdev_ops);
+
+	sc2336->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc2336->regmap))
+		return dev_err_probe(sc2336->dev, PTR_ERR(sc2336->regmap),
+				     "failed to init CCI\n");
+
+	sc2336->mclk = devm_v4l2_sensor_clk_get(sc2336->dev, NULL);
+	if (IS_ERR(sc2336->mclk))
+		return dev_err_probe(sc2336->dev, PTR_ERR(sc2336->mclk),
+				     "failed to get MCLK\n");
+
+	freq = clk_get_rate(sc2336->mclk);
+	if (freq != SC2336_MCLK_FREQ_24MHZ)
+		return dev_err_probe(sc2336->dev, -EINVAL,
+				     "MCLK frequency %lu Hz is not supported\n",
+				     freq);
+
+	sc2336->reset_gpio = devm_gpiod_get_optional(sc2336->dev, "reset",
+						     GPIOD_OUT_HIGH);
+	if (IS_ERR(sc2336->reset_gpio))
+		return dev_err_probe(sc2336->dev, PTR_ERR(sc2336->reset_gpio),
+				     "failed to get reset GPIO\n");
+
+	for (i = 0; i < SC2336_NUM_SUPPLIES; i++)
+		sc2336->supplies[i].supply = sc2336_supply_names[i];
+
+	ret = devm_regulator_bulk_get(sc2336->dev, SC2336_NUM_SUPPLIES,
+				      sc2336->supplies);
+	if (ret)
+		return dev_err_probe(sc2336->dev, ret,
+				     "failed to get supplies\n");
+
+	/* The sensor must be powered on to read the chip ID */
+	ret = sc2336_power_on(sc2336->dev);
+	if (ret)
+		return ret;
+
+	ret = sc2336_identify(sc2336);
+	if (ret)
+		goto power_off;
+
+	ret = sc2336_init_controls(sc2336);
+	if (ret) {
+		dev_err_probe(sc2336->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	sc2336->sd.state_lock = sc2336->ctrl_handler.lock;
+	sc2336->sd.internal_ops = &sc2336_internal_ops;
+	sc2336->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc2336->sd.entity.ops = &sc2336_entity_ops;
+	sc2336->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc2336->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc2336->sd.entity, 1, &sc2336->pad);
+	if (ret) {
+		dev_err_probe(sc2336->dev, ret, "failed to init entity pads\n");
+		goto free_ctrls;
+	}
+
+	ret = v4l2_subdev_init_finalize(&sc2336->sd);
+	if (ret) {
+		dev_err_probe(sc2336->dev, ret, "failed to init subdev\n");
+		goto entity_cleanup;
+	}
+
+	pm_runtime_set_active(sc2336->dev);
+	pm_runtime_enable(sc2336->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc2336->sd);
+	if (ret) {
+		dev_err_probe(sc2336->dev, ret, "failed to register subdev\n");
+		goto subdev_cleanup;
+	}
+
+	/* Let runtime PM power the sensor down until it is used */
+	pm_runtime_set_autosuspend_delay(sc2336->dev, 1000);
+	pm_runtime_use_autosuspend(sc2336->dev);
+	pm_runtime_idle(sc2336->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&sc2336->sd);
+	pm_runtime_disable(sc2336->dev);
+	pm_runtime_set_suspended(sc2336->dev);
+entity_cleanup:
+	media_entity_cleanup(&sc2336->sd.entity);
+free_ctrls:
+	v4l2_ctrl_handler_free(&sc2336->ctrl_handler);
+power_off:
+	sc2336_power_off(sc2336->dev);
+
+	return ret;
+}
+
+static void sc2336_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc2336 *sc2336 = to_sc2336(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&sc2336->ctrl_handler);
+	pm_runtime_disable(sc2336->dev);
+
+	if (!pm_runtime_status_suspended(sc2336->dev)) {
+		sc2336_power_off(sc2336->dev);
+		pm_runtime_set_suspended(sc2336->dev);
+	}
+}
+
+static DEFINE_RUNTIME_DEV_PM_OPS(sc2336_pm_ops, sc2336_power_off,
+				 sc2336_power_on, NULL);
+
+static const struct of_device_id sc2336_of_match[] = {
+	{ .compatible = "smartsens,sc2336" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, sc2336_of_match);
+
+static struct i2c_driver sc2336_i2c_driver = {
+	.driver = {
+		.name = "sc2336",
+		.pm = pm_ptr(&sc2336_pm_ops),
+		.of_match_table = sc2336_of_match,
+	},
+	.probe = sc2336_probe,
+	.remove = sc2336_remove,
+};
+
+module_i2c_driver(sc2336_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC2336 image sensor driver");
+MODULE_LICENSE("GPL");
