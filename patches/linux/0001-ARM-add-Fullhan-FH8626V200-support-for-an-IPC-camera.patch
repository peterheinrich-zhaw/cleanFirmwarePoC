diff --git a/drivers/clk/clk-fh8626.c b/drivers/clk/clk-fh8626.c
new file mode 100644
index 0000000..62ec5e3
--- /dev/null
+++ b/drivers/clk/clk-fh8626.c
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Fullhan FH8626V200 PMU clocks
+ *
+ * The PMU at 0xf0000000 holds the PLL configuration and, per peripheral
+ * clock, a parent select bit, a divider field and a gate bit.  Only the
+ * clocks needed so far are described here; more can be added to the
+ * table as drivers need them.
+ *
+ * Register layout and formulas come from a static analysis of the stock
+ * firmware (kernel 4.9.129, fh_clks table and its clk ops):
+ *
+ *  - divider: rate = parent / (field + 1)
+ *  - mux:     field value = parent index
+ *  - gate:    bit set = clock off (confirmed on the board: setting the
+ *             i2c0 gate makes the controller registers read as 0)
+ *  - PLL:     rate = osc * M / (N + 1) / (P + 1) / POST
+ *
+ * The PLL rates computed this way give 16.667 MHz for uart0_clk, the
+ * rate the console has been running on.  No vendor code is used.
+ *
+ * The PLL and cpu_div15 are read-only: they are set up by the boot loader
+ * and feed the CPU, the bus and the UART.  The UART divider is read-only
+ * and its gate critical for the same reason.
+ *
+ * The register block is shared with the syscon users of the PMU node
+ * (USB PHY) and with pinctrl-single (pad registers at 0x80), so it is
+ * mapped without claiming the region.
+ */
+#include <dt-bindings/clock/fullhan,fh8626-pmu.h>
+#include <linux/bits.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/spinlock.h>
+
+#define PMU_PLL_CPU_CFG		0x14
+#define PMU_SEL			0x0c
+#define PMU_GATE0		0x1c
+#define PMU_DIV_28		0x28
+#define PMU_DIV_34		0x34
+#define PMU_DIV_38		0x38
+#define PMU_PLL_CPU_POST	0x64
+
+#define FH8626_NR_CLKS		(FH8626_CLK_CIS + 1)
+#define FH8626_OSC		(-1)	/* parent: the "osc" input clock */
+
+struct fh8626_pll {
+	struct clk_hw hw;
+	void __iomem *cfg;
+	void __iomem *post;
+	u8 p_shift;	/* P field in cfg: 16 for pclk, 24 for rclk */
+	u8 post_shift;	/* POST field in post: 8 for pclk, 12 for rclk */
+};
+
+#define to_fh8626_pll(_hw) container_of(_hw, struct fh8626_pll, hw)
+
+static unsigned int fh8626_pll_post_div(u32 field)
+{
+	switch (field) {
+	case 0:
+		return 1;
+	case 8:
+		return 2;
+	case 12:
+		return 4;
+	case 13:
+		return 8;
+	case 14:
+		return 16;
+	case 15:
+		return 32;
+	default:
+		return 0;
+	}
+}
+
+static unsigned long fh8626_pll_recalc_rate(struct clk_hw *hw,
+					    unsigned long parent_rate)
+{
+	struct fh8626_pll *pll = to_fh8626_pll(hw);
+	u32 cfg = readl(pll->cfg);
+	u32 m = cfg & 0x7f;
+	u32 n = (cfg >> 8) & 0x1f;
+	u32 p = (cfg >> pll->p_shift) & 0x3f;
+	unsigned int post;
+	u64 rate;
+
+	/* Special M encodings, as handled by the stock code */
+	if (m <= 3)
+		m += 128;
+	else if (m == 11)
+		m = 10;
+
+	post = fh8626_pll_post_div((readl(pll->post) >> pll->post_shift) & 0xf);
+	if (!post) {
+		pr_warn("%s: unknown post divider\n", clk_hw_get_name(hw));
+		post = 1;
+	}
+
+	rate = (u64)parent_rate * m;
+	rate = div_u64(rate, n + 1);
+	rate = div_u64(rate, p + 1);
+	return div_u64(rate, post);
+}
+
+static const struct clk_ops fh8626_pll_ops = {
+	.recalc_rate = fh8626_pll_recalc_rate,
+};
+
+/* Peripheral clock: optional mux, divider, optional gate */
+struct fh8626_periph {
+	int id;
+	const char *name;
+	int parents[2];
+	u8 num_parents;
+	u16 mux_reg;
+	u8 mux_shift;
+	u16 div_reg;
+	u8 div_shift;
+	u8 div_width;
+	u8 div_flags;
+	u16 gate_reg;		/* 0: no gate */
+	u8 gate_bit;
+	unsigned long flags;
+};
+
+static const struct fh8626_periph fh8626_periphs[] = {
+	{
+		.id = FH8626_CLK_CPU_DIV15, .name = "cpu_div15_clk",
+		.parents = { FH8626_CLK_PLL_CPU_P }, .num_parents = 1,
+		.div_reg = PMU_DIV_38, .div_shift = 24, .div_width = 8,
+		.div_flags = CLK_DIVIDER_READ_ONLY,
+	}, {
+		.id = FH8626_CLK_UART0, .name = "uart0_clk",
+		.parents = { FH8626_CLK_CPU_DIV15 }, .num_parents = 1,
+		.div_reg = PMU_DIV_34, .div_shift = 0, .div_width = 6,
+		.div_flags = CLK_DIVIDER_READ_ONLY,
+		.gate_reg = PMU_GATE0, .gate_bit = 13,
+		.flags = CLK_IS_CRITICAL,
+	}, {
+		.id = FH8626_CLK_I2C0, .name = "i2c0_clk",
+		.parents = { FH8626_CLK_CPU_DIV15 }, .num_parents = 1,
+		.div_reg = PMU_DIV_34, .div_shift = 16, .div_width = 6,
+		.gate_reg = PMU_GATE0, .gate_bit = 12,
+	}, {
+		.id = FH8626_CLK_CIS, .name = "cis_clk_out",
+		.parents = { FH8626_OSC, FH8626_CLK_PLL_CPU_P }, .num_parents = 2,
+		.mux_reg = PMU_SEL, .mux_shift = 4,
+		.div_reg = PMU_DIV_28, .div_shift = 16, .div_width = 8,
+		.gate_reg = PMU_GATE0, .gate_bit = 23,
+	},
+};
+
+struct fh8626_clk {
+	void __iomem *base;
+	spinlock_t lock;	/* shared registers: gates, dividers */
+	struct clk_hw_onecell_data *data;
+};
+
+static struct clk_hw *fh8626_register_periph(struct device *dev,
+					     struct fh8626_clk *c,
+					     const struct fh8626_periph *p)
+{
+	struct clk_parent_data pdata[2] = {};
+	struct clk_hw *mux_hw = NULL, *gate_hw = NULL;
+	struct clk_divider *div;
+	int i;
+
+	for (i = 0; i < p->num_parents; i++) {
+		if (p->parents[i] == FH8626_OSC)
+			pdata[i].fw_name = "osc";
+		else
+			pdata[i].hw = c->data->hws[p->parents[i]];
+	}
+
+	if (p->num_parents > 1) {
+		struct clk_mux *mux = devm_kzalloc(dev, sizeof(*mux), GFP_KERNEL);
+
+		if (!mux)
+			return ERR_PTR(-ENOMEM);
+		mux->reg = c->base + p->mux_reg;
+		mux->shift = p->mux_shift;
+		mux->mask = BIT(fls(p->num_parents - 1)) - 1;
+		mux->lock = &c->lock;
+		mux_hw = &mux->hw;
+	}
+
+	div = devm_kzalloc(dev, sizeof(*div), GFP_KERNEL);
+	if (!div)
+		return ERR_PTR(-ENOMEM);
+	div->reg = c->base + p->div_reg;
+	div->shift = p->div_shift;
+	div->width = p->div_width;
+	div->flags = p->div_flags;
+	div->lock = &c->lock;
+
+	if (p->gate_reg) {
+		struct clk_gate *gate = devm_kzalloc(dev, sizeof(*gate), GFP_KERNEL);
+
+		if (!gate)
+			return ERR_PTR(-ENOMEM);
+		gate->reg = c->base + p->gate_reg;
+		gate->bit_idx = p->gate_bit;
+		gate->flags = CLK_GATE_SET_TO_DISABLE;
+		gate->lock = &c->lock;
+		gate_hw = &gate->hw;
+	}
+
+	return devm_clk_hw_register_composite_pdata(dev, p->name, pdata,
+			p->num_parents,
+			mux_hw, mux_hw ? &clk_mux_ops : NULL,
+			&div->hw, (p->div_flags & CLK_DIVIDER_READ_ONLY) ?
+				  &clk_divider_ro_ops : &clk_divider_ops,
+			gate_hw, gate_hw ? &clk_gate_ops : NULL,
+			p->flags);
+}
+
+static int fh8626_clk_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_parent_data osc = { .fw_name = "osc" };
+	struct clk_init_data init = {};
+	struct fh8626_pll *pll;
+	struct resource *res;
+	struct fh8626_clk *c;
+	struct clk_hw *hw;
+	int i, ret;
+
+	c = devm_kzalloc(dev, sizeof(*c), GFP_KERNEL);
+	if (!c)
+		return -ENOMEM;
+	c->data = devm_kzalloc(dev, struct_size(c->data, hws, FH8626_NR_CLKS),
+			       GFP_KERNEL);
+	if (!c->data)
+		return -ENOMEM;
+	c->data->num = FH8626_NR_CLKS;
+	for (i = 0; i < FH8626_NR_CLKS; i++)
+		c->data->hws[i] = ERR_PTR(-ENOENT);
+	spin_lock_init(&c->lock);
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res)
+		return -EINVAL;
+	/* Not devm_ioremap_resource(): the region is shared, see above */
+	c->base = devm_ioremap(dev, res->start, resource_size(res));
+	if (!c->base)
+		return -ENOMEM;
+
+	pll = devm_kzalloc(dev, sizeof(*pll), GFP_KERNEL);
+	if (!pll)
+		return -ENOMEM;
+	pll->cfg = c->base + PMU_PLL_CPU_CFG;
+	pll->post = c->base + PMU_PLL_CPU_POST;
+	pll->p_shift = 16;
+	pll->post_shift = 8;
+	init.name = "pll_cpu_pclk";
+	init.ops = &fh8626_pll_ops;
+	init.parent_data = &osc;
+	init.num_parents = 1;
+	pll->hw.init = &init;
+	ret = devm_clk_hw_register(dev, &pll->hw);
+	if (ret)
+		return dev_err_probe(dev, ret, "cannot register %s\n", init.name);
+	c->data->hws[FH8626_CLK_PLL_CPU_P] = &pll->hw;
+
+	for (i = 0; i < ARRAY_SIZE(fh8626_periphs); i++) {
+		const struct fh8626_periph *p = &fh8626_periphs[i];
+
+		hw = fh8626_register_periph(dev, c, p);
+		if (IS_ERR(hw))
+			return dev_err_probe(dev, PTR_ERR(hw),
+					     "cannot register %s\n", p->name);
+		c->data->hws[p->id] = hw;
+	}
+
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, c->data);
+}
+
+static const struct of_device_id fh8626_clk_of_match[] = {
+	{ .compatible = "fullhan,fh8626-pmu" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, fh8626_clk_of_match);
+
+static struct platform_driver fh8626_clk_driver = {
+	.probe = fh8626_clk_probe,
+	.driver = {
+		.name = "fh8626-clk",
+		.of_match_table = fh8626_clk_of_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(fh8626_clk_driver);
+
+MODULE_DESCRIPTION("Fullhan FH8626V200 PMU clock driver");
+MODULE_LICENSE("GPL");
