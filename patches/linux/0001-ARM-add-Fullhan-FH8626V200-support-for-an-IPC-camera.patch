diff --git a/drivers/phy/Makefile b/drivers/phy/Makefile
index bfb27fb..9842bb1 100644
--- a/drivers/phy/Makefile
+++ b/drivers/phy/Makefile
@@ -42,3 +42,4 @@ obj-y					+= allwinner/	\
 					   tegra/	\
 					   ti/		\
 					   xilinx/
+obj-$(CONFIG_PHY_FH8626_USB)	+= phy-fh8626-usb.o
diff --git a/drivers/phy/phy-fh8626-usb.c b/drivers/phy/phy-fh8626-usb.c
new file mode 100644
index 0000000..42c5643
--- /dev/null
+++ b/drivers/phy/phy-fh8626-usb.c
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Fullhan FH8626V200 USB 2.0 PHY
+ *
+ * The DWC2 core on this SoC cannot finish its soft reset (GRSTCTL.CSFTRST
+ * never clears) until the on-chip UTMI PHY has been taken out of reset
+ * through the PMU.  This driver does that as the PHY's init step, so that
+ * the generic dwc2 platform driver (which calls phy_init() before the core
+ * reset) works unmodified.
+ *
+ * Register offsets, bit positions and order come from a static analysis of
+ * the stock firmware (kernel 4.9.129, helpers fh_pmu_usb_phy_rst,
+ * fh_pmu_usb_utmi_rst, fh_pmu_usb_resume, fh_pmu_usb_tune) and were
+ * confirmed on the board: with PMU 0x228 bit 10 cleared the soft reset
+ * completes.  The *meaning* of the individual bits is inferred from the
+ * helper names only.  No vendor code is used; this is an independent
+ * implementation of the observed register sequence.
+ *
+ * VBUS: the module on the port is not powered by the controller.  The
+ * stock kernel switches a GPIO named "usb_pwren" (GPIO47 on the camera
+ * board; platform data of the stock fh_usb device).  Here that is an
+ * optional "vbus" regulator which is enabled in power_on, i.e. after the
+ * PHY has been released and before the controller starts the port.
+ */
+
+#include <linux/bits.h>
+#include <linux/delay.h>
+#include <linux/mfd/syscon.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/phy/phy.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+
+#define PMU_UTMI_RST		0x040	/* bit 1: UTMI reset, 0 = asserted */
+#define  UTMI_RST_N		BIT(1)
+
+#define PMU_USB_CTRL		0x210
+#define  USB_CTRL_PHY_RST	(BIT(0) | BIT(4))	/* 1 = asserted */
+#define  USB_CTRL_RESUME	BIT(24)
+
+#define PMU_USB_TUNE		0x218
+#define  USB_TUNE_VALUE		0x78203344
+
+#define PMU_USB_PHY_CTRL	0x228
+#define  USB_PHY_HOLD		BIT(10)	/* set at reset, stock clears it */
+
+#define FH8626_USB_PHY_SETTLE_MS	50
+#define FH8626_USB_UTMI_SETTLE_MS	20
+
+struct fh8626_usb_phy {
+	struct regmap *pmu;
+	struct regulator *vbus;	/* optional */
+};
+
+static int fh8626_usb_phy_init(struct phy *phy)
+{
+	struct fh8626_usb_phy *p = phy_get_drvdata(phy);
+	struct regmap *pmu = p->pmu;
+	int ret;
+
+	/* 1. PHY reset (fh_pmu_usb_phy_rst) */
+	ret = regmap_update_bits(pmu, PMU_USB_PHY_CTRL, USB_PHY_HOLD, 0);
+	if (ret)
+		return ret;
+	msleep(FH8626_USB_PHY_SETTLE_MS);
+
+	ret = regmap_update_bits(pmu, PMU_USB_CTRL, USB_CTRL_PHY_RST,
+				 USB_CTRL_PHY_RST);
+	if (ret)
+		return ret;
+	msleep(FH8626_USB_PHY_SETTLE_MS);
+
+	ret = regmap_update_bits(pmu, PMU_USB_CTRL, USB_CTRL_PHY_RST, 0);
+	if (ret)
+		return ret;
+
+	/* 2. UTMI reset pulse (fh_pmu_usb_utmi_rst) */
+	ret = regmap_update_bits(pmu, PMU_UTMI_RST, UTMI_RST_N, 0);
+	if (ret)
+		return ret;
+	msleep(FH8626_USB_PHY_SETTLE_MS);
+
+	ret = regmap_update_bits(pmu, PMU_UTMI_RST, UTMI_RST_N, UTMI_RST_N);
+	if (ret)
+		return ret;
+	msleep(FH8626_USB_UTMI_SETTLE_MS);
+
+	/* 3. resume (fh_pmu_usb_resume) */
+	ret = regmap_update_bits(pmu, PMU_USB_CTRL, USB_CTRL_RESUME,
+				 USB_CTRL_RESUME);
+	if (ret)
+		return ret;
+	msleep(FH8626_USB_PHY_SETTLE_MS);
+
+	/* 4. tuning value (fh_pmu_usb_tune) */
+	return regmap_write(pmu, PMU_USB_TUNE, USB_TUNE_VALUE);
+}
+
+static int fh8626_usb_phy_power_on(struct phy *phy)
+{
+	struct fh8626_usb_phy *p = phy_get_drvdata(phy);
+
+	return p->vbus ? regulator_enable(p->vbus) : 0;
+}
+
+static int fh8626_usb_phy_power_off(struct phy *phy)
+{
+	struct fh8626_usb_phy *p = phy_get_drvdata(phy);
+
+	return p->vbus ? regulator_disable(p->vbus) : 0;
+}
+
+static const struct phy_ops fh8626_usb_phy_ops = {
+	.init		= fh8626_usb_phy_init,
+	.power_on	= fh8626_usb_phy_power_on,
+	.power_off	= fh8626_usb_phy_power_off,
+	.owner	= THIS_MODULE,
+};
+
+static int fh8626_usb_phy_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct phy_provider *provider;
+	struct fh8626_usb_phy *p;
+	struct phy *phy;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	p->pmu = syscon_regmap_lookup_by_phandle(dev->of_node, "fullhan,pmu");
+	if (IS_ERR(p->pmu))
+		return dev_err_probe(dev, PTR_ERR(p->pmu),
+				     "cannot get the PMU syscon\n");
+
+	p->vbus = devm_regulator_get_optional(dev, "vbus");
+	if (IS_ERR(p->vbus)) {
+		if (PTR_ERR(p->vbus) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(p->vbus),
+					     "cannot get the vbus regulator\n");
+		p->vbus = NULL;
+	}
+
+	phy = devm_phy_create(dev, NULL, &fh8626_usb_phy_ops);
+	if (IS_ERR(phy))
+		return dev_err_probe(dev, PTR_ERR(phy),
+				     "cannot create the PHY\n");
+
+	phy_set_drvdata(phy, p);
+
+	provider = devm_of_phy_provider_register(dev, of_phy_simple_xlate);
+	return PTR_ERR_OR_ZERO(provider);
+}
+
+static const struct of_device_id fh8626_usb_phy_of_match[] = {
+	{ .compatible = "fullhan,fh8626-usb-phy" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, fh8626_usb_phy_of_match);
+
+static struct platform_driver fh8626_usb_phy_driver = {
+	.probe	= fh8626_usb_phy_probe,
+	.driver	= {
+		.name		= "phy-fh8626-usb",
+		.of_match_table	= fh8626_usb_phy_of_match,
+	},
+};
+module_platform_driver(fh8626_usb_phy_driver);
+
+MODULE_DESCRIPTION("Fullhan FH8626V200 USB 2.0 PHY driver");
+MODULE_LICENSE("GPL");
