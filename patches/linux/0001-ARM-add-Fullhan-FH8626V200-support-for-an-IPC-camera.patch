diff --git a/arch/arm/mach-fh8626/fh8626.c b/arch/arm/mach-fh8626/fh8626.c
new file mode 100644
index 0000000..bf57a88
--- /dev/null
+++ b/arch/arm/mach-fh8626/fh8626.c
@@ -0,0 +1,57 @@
+/*
+ * Fullhan FH8626V200 machine support (device tree only).
+ *
+ * GPL-2.0. Independent of arch/arm/mach-fh: the OpenIPC FH885x code
+ * targets ARM1176 parts and is not used here.
+ *
+ * PMU chip-ID offsets (0x00 plat id, 0x04 ip version) come from the
+ * FH885x sources (REG_PMU_CHIP_ID / REG_PMU_IP_VER); for V200 the
+ * value 0x20102801 was observed on hardware, not taken from a source.
+ */
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <asm/mach/arch.h>
+
+#define FH8626_PMU_CHIP_ID	0x00
+#define FH8626_PMU_IP_VER	0x04
+#define FH8626V200_PLAT_ID	0x20102801
+
+static void __init fh8626_report_chip(void)
+{
+	struct device_node *np;
+	void __iomem *base;
+
+	np = of_find_compatible_node(NULL, NULL, "fh,fh8626-pmu");
+	if (!np)
+		return;
+	base = of_iomap(np, 0);
+	if (base) {
+		u32 id = readl(base + FH8626_PMU_CHIP_ID);
+
+		pr_info("FH8626: PMU chip id %08x ip ver %08x%s\n", id,
+			readl(base + FH8626_PMU_IP_VER),
+			id == FH8626V200_PLAT_ID ? "" : " (UNEXPECTED)");
+		iounmap(base);
+	}
+	of_node_put(np);
+}
+
+static void __init fh8626_init_machine(void)
+{
+	fh8626_report_chip();
+	of_platform_default_populate(NULL, NULL, NULL);
+}
+
+static const char *const fh8626_dt_compat[] __initconst = {
+	"fh,fh8626v200",
+	NULL
+};
+
+DT_MACHINE_START(FH8626, "Fullhan FH8626V200 (Device Tree)")
+	.dt_compat	= fh8626_dt_compat,
+	.init_machine	= fh8626_init_machine,
+MACHINE_END
