diff --git a/include/configs/fh8626.h b/include/configs/fh8626.h
new file mode 100644
index 0000000..2f0a16d
--- /dev/null
+++ b/include/configs/fh8626.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef __CONFIG_FH8626_H
+#define __CONFIG_FH8626_H
+
+#define CFG_SYS_SDRAM_BASE	0xA0000000
+
+/*
+ * Pre-relocation stack + global data, in already-trained DRAM,
+ * 2 MiB above the load address (clear of image + BSS).
+ * Plain hex only: these are used from assembly (start.S).
+ */
+#define CFG_SYS_INIT_RAM_ADDR	0xA0200000
+#define CFG_SYS_INIT_RAM_SIZE	0x00010000
+
+
+#ifndef __ASSEMBLY__
+#define FH_MARK(c) do { \
+	while (!(*(volatile unsigned int *)0xF070007C & 2)) ; \
+	*(volatile unsigned int *)0xF0700000 = (c); } while (0)
+#endif
+
+#endif
