diff --git a/arch/arm/dts/fh8626.dts b/arch/arm/dts/fh8626.dts
new file mode 100644
index 0000000..bb8e63e
--- /dev/null
+++ b/arch/arm/dts/fh8626.dts
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0+
+/dts-v1/;
+
+/ {
+	#address-cells = <1>;
+	#size-cells = <1>;
+	model = "FullHan FH8626V200";
+	compatible = "fullhan,fh8626";
+
+	aliases {
+		serial0 = &uart0;
+		spi0 = &spi0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootph-all;
+	};
+
+	memory@a0000000 {
+		device_type = "memory";
+		reg = <0xa0000000 0x04000000>;
+	};
+
+	spi_clk: spi-clk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <200000000>;
+	};
+
+	soc {
+		compatible = "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		bootph-all;
+
+		uart0: serial@f0700000 {
+			compatible = "snps,dw-apb-uart";
+			reg = <0xf0700000 0x100>;
+			reg-shift = <2>;
+			reg-io-width = <4>;
+			clock-frequency = <16666667>;
+			bootph-all;
+		};
+
+		gpio0: gpio@f0300000 {
+			compatible = "snps,dw-apb-gpio";
+			reg = <0xf0300000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			porta: gpio-controller@0 {
+				compatible = "snps,dw-apb-gpio-port";
+				gpio-controller;
+				#gpio-cells = <2>;
+				snps,nr-gpios = <32>;
+				reg = <0>;
+			};
+		};
+
+		spi0: spi@f0500000 {
+			compatible = "snps,dw-apb-ssi";
+			reg = <0xf0500000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			clocks = <&spi_clk>;
+			spi-max-frequency = <25000000>;
+			cs-gpios = <&porta 6 0>;
+
+			flash@0 {
+				compatible = "jedec,spi-nor";
+				reg = <0>;
+				spi-max-frequency = <25000000>;
+			};
+		};
+	};
+};
