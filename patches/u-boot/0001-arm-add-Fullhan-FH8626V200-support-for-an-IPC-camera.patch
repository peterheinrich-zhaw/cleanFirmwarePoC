diff --git a/board/fh8626/fh8626.c b/board/fh8626/fh8626.c
new file mode 100644
index 0000000..8077b58
--- /dev/null
+++ b/board/fh8626/fh8626.c
@@ -0,0 +1,53 @@
+#include <init.h>
+#include <linux/sizes.h>
+#include <asm/global_data.h>
+#include <asm/io.h>     /* readl */
+#include <linux/delay.h> /* udelay */
+
+DECLARE_GLOBAL_DATA_PTR;
+
+/* board/fh8626/fh8626.c */
+void board_debug_uart_init(void)
+{
+}
+
+int  board_early_init_f(void) { return 0; }
+int  dram_init(void)        { gd->ram_size = SZ_64M; return 0; }
+
+int board_init(void) { 
+	
+	unsigned int midr, ctr, pfr0, pfr1, isar0;
+
+	unsigned int cpsr, sctlr, cbar, cntfrq, l2ctlr;
+	unsigned int lo1, hi1, lo2, hi2;
+
+	asm volatile("mrs %0, cpsr" : "=r"(cpsr));
+	asm volatile("mrc p15, 0, %0, c1, c0, 0" : "=r"(sctlr));
+	printf("CPSR=%08x (mode %02x) SCTLR=%08x\n", cpsr, cpsr & 0x1f, sctlr);
+
+	asm volatile("mrc p15, 4, %0, c15, c0, 0" : "=r"(cbar));
+	printf("CBAR=%08x\n", cbar);
+
+	asm volatile("mrc p15, 1, %0, c9, c0, 2" : "=r"(l2ctlr));
+	printf("L2CTLR=%08x (cores-1=%u)\n", l2ctlr, (l2ctlr >> 24) & 3);
+
+	asm volatile("mrc p15, 0, %0, c14, c0, 0" : "=r"(cntfrq));
+	asm volatile("mrrc p15, 0, %0, %1, c14" : "=r"(lo1), "=r"(hi1));
+	udelay(10000);
+	asm volatile("mrrc p15, 0, %0, %1, c14" : "=r"(lo2), "=r"(hi2));
+	printf("CNTFRQ=%u CNTPCT %08x:%08x -> %08x:%08x (10ms)\n",
+       cntfrq, hi1, lo1, hi2, lo2);
+
+	/* GIC distributor sits at PERIPHBASE+0x1000: TYPER @+4, IIDR @+8.
+	 * Printed last: a bad CBAR would abort here, after the lines above. */
+	if (cbar) {
+		printf("GICD_TYPER=%08x GICD_IIDR=%08x\n",
+		       readl(cbar + 0x1000 + 0x4), readl(cbar + 0x1000 + 0x8));
+	}	
+
+	gd->bd->bi_boot_params = CFG_SYS_SDRAM_BASE + 0x100; 
+
+	return 0; 
+
+}
+
