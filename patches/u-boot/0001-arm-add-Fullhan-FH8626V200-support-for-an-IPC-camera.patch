+++ b/arch/arm/mach-fh8626/fh8626.c
@@ -0,0 +1,26 @@
+// SPDX-License-Identifier: GPL-2.0+
+#include <init.h>
+#include <stdio.h>
+#include <asm/io.h>
+
+void fh8626_timer_start(void);
+
+int arch_cpu_init(void)
+{
+	fh8626_timer_start();
+	return 0;
+}
+
+int print_cpuinfo(void)
+{
+	/* PMU chip ID: V100 table says 0x18112301; V200 unverified */
+	printf("CPU:   FH8626, chip id 0x%08x\n", readl((void *)0xF0000000));
+	return 0;
+}
+
+void reset_cpu(void)
+{
+	/* TODO: real reset (WDT at 0xF0D00000 or PMU SYS reset). Hang for now. */
+	while (1)
+		;
+}
diff --git a/arch/arm/mach-fh8626/timer.c b/arch/arm/mach-fh8626/timer.c
new file mode 100644
index 0000000..0053080
--- /dev/null
+++ b/arch/arm/mach-fh8626/timer.c
@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-2.0+
+#include <init.h>
+#include <time.h>
+#include <asm/io.h>
+
+#define FH_TIMER_BASE	0xF0C00000
+#define FH_TIMER_IDX	0			/* each timer block is 0x14 bytes */
+#define TMR(off)	((void *)(FH_TIMER_BASE + FH_TIMER_IDX * 0x14 + (off)))
+#define TMR_LOAD	0x00
+#define TMR_CUR		0x04
+#define TMR_CTRL	0x08
+#define TMR_EN		BIT(0)
+#define TMR_INTMASK	BIT(2)			/* bit1 = 0: free-running */
+
+#define FH_TIMER_CLK	50000000UL		/* SoC value per hl.h; verify */
+
+void fh8626_timer_start(void)
+{
+	writel(0, TMR(TMR_CTRL));
+	writel(0xffffffff, TMR(TMR_LOAD));
+	writel(TMR_EN | TMR_INTMASK, TMR(TMR_CTRL));
+}
+
+/* DW timers count down; lib/time.c wants an up-counter */
+unsigned long timer_read_counter(void)
+{
+	return ~readl(TMR(TMR_CUR));
+}
+
+ulong get_tbclk(void)
+{
+	return FH_TIMER_CLK;
+}
